<style>
  .qld-card { padding: 8px 12px; height: 100%; box-sizing: border-box; }
  .qld-grid { display: flex; height: 100%; gap: 18px; }
  .qld-illustration { flex: 0 0 300px; display: flex; align-items: center; justify-content: center; border-right: 2px solid #000; padding-right: 18px; }
  .qld-illustration img { max-width: 100%; max-height: 420px; width: auto; height: auto; object-fit: contain; }
  .qld-info { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .qld-rule { border: none; border-top: 2px solid #000; margin: 8px 0; }
  .qld-rule--thin { border: none; border-top: 1px solid #000; margin: 6px 0; }
  .qld-sci { font-style: italic; }
  .qld-section-label { text-transform: uppercase; font-weight: 700; letter-spacing: 1px; }
  .qld-taxo-table { width: 100%; border-collapse: collapse; }
  .qld-taxo-table td { padding: 1px 0; vertical-align: top; }
  .qld-taxo-table td:first-child { font-weight: 700; width: 100px; }
  .qld-footer { display: flex; justify-content: space-between; align-items: baseline; margin-top: auto; }
  .qld-badge { font-weight: 700; letter-spacing: 2px; text-transform: uppercase; }
</style>

{% assign day_num = 'now' | date: '%j' | plus: 0 %}
{% assign plant_count = plants.size %}
{% assign plant_index = day_num | modulo: plant_count %}
{% assign plant = plants[plant_index] %}

<div class="view view--full">
  <div class="layout qld-card">
    <div class="qld-grid">

      <div class="qld-illustration">
        <img src="{{ plant.illustration_url }}" />
      </div>

      <div class="qld-info">
        <span class="title title--large">{{ plant.name }}</span>
        <span class="description text--large qld-sci">{{ plant.scientific_name }}</span>

        <hr class="qld-rule" />

        <span class="label qld-section-label">Range</span>
        <span class="value value--medium">{{ plant.range }}</span>

        <hr class="qld-rule--thin" />

        <span class="label qld-section-label">Edible Parts</span>
        <span class="value value--medium">{{ plant.edible_parts }}</span>

        <hr class="qld-rule--thin" />

        <span class="label qld-section-label">Taxonomy</span>
        <table class="qld-taxo-table">
          <tr><td>Phylum</td><td>{{ plant.taxonomy.phylum }}</td></tr>
          <tr><td>Class</td><td>{{ plant.taxonomy.class }}</td></tr>
          <tr><td>Order</td><td>{{ plant.taxonomy.order }}</td></tr>
          <tr><td>Family</td><td>{{ plant.taxonomy.family }}</td></tr>
          <tr><td>Genus</td><td>{{ plant.taxonomy.genus }}</td></tr>
          <tr><td>Species</td><td class="qld-sci">{{ plant.taxonomy.species }}</td></tr>
        </table>

        <hr class="qld-rule" />

        <div class="qld-footer">
          <span class="label">Card {{ plant_index | plus: 1 }} of {{ plant_count }}</span>
          <span class="qld-badge">Queensland Native</span>
        </div>
      </div>

    </div>
  </div>
</div>
